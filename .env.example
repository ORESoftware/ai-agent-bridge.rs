# Provider credentials are injected at runtime by a secret manager.
# Leave credential values empty in this committed example.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=

# Provider configuration contains only environment-variable names, never keys.
AI_PROVIDER_CONFIG_JSON='[{"name":"openai","protocol":"open_ai_responses","base_url":"https://api.openai.com/v1/","model":"YOUR_OPENAI_MODEL","api_key_env":"OPENAI_API_KEY","allowed_hosts":["api.openai.com"]}]'
